#!/bin/bash

# ============================================================
# lockscreen - School21 session-keep-alive tool
# Usage:
#   lockscreen 6h       -> lock screen now, keep session alive 6h
#   lockscreen 30m      -> lock screen now, keep session alive 30 min
#   lockscreen off      -> cancel timer, restore settings
#   lockscreen status   -> show current status
#   lockscreen dry-run 6h -> show what would happen (no side effects)
#
# Problem: School21 auto-logs out the session after 30 min idle
# (systemd-logind IdleActionSec). Even a locked screen is "idle"
# for logind, so the session dies while you are away.
# Solution: register an idle inhibitor (systemd-inhibit) so logind
# never considers the session idle, then lock the screen.
# ============================================================

TIMER_FILE="$HOME/.lockscreen_timer"
INHIBITOR_FILE="$HOME/.lockscreen_inhibitor_pid"
RESTORE_SCRIPT="$HOME/.lockscreen_restore.sh"
SETTINGS_FILE="$HOME/.lockscreen_settings"
LOG_FILE="$HOME/.lockscreen.log"

# Default idle timeout in seconds (30 minutes = 1800)
DEFAULT_IDLE_DELAY=1800

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
}

# Parse time argument: 6h -> 21600 seconds, 30m -> 1800 seconds
parse_time() {
    local input="$1"
    local value="${input%[hHmMsS]}"
    local unit="${input: -1}"

    if ! [[ "$value" =~ ^[0-9]+$ ]]; then
        echo "ERROR: Invalid time format. Use: 6h, 30m, 3600s"
        exit 1
    fi

    case "$unit" in
        h|H) echo $((value * 3600)) ;;
        m|M) echo $((value * 60)) ;;
        s|S) echo "$value" ;;
        *)   echo "ERROR: Unknown time unit '$unit'. Use h, m, or s."
             exit 1 ;;
    esac
}

# Human-readable duration: 21600 -> "6h", 5400 -> "1h 30m"
human_time() {
    local seconds="$1"
    if [ "$seconds" -ge 3600 ]; then
        local h=$((seconds / 3600))
        local m=$((seconds % 3600 / 60))
        if [ "$m" -gt 0 ]; then
            echo "${h}h ${m}m"
        else
            echo "${h}h"
        fi
    else
        echo "$((seconds / 60))m"
    fi
}

# Ensure DISPLAY and DBUS are set (needed when called from cron/background)
ensure_display() {
    if [ -z "$DISPLAY" ]; then
        export DISPLAY=":0"
    fi
    if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
    fi
}

# Detect which screen lock system is in use
detect_lock_system() {
    ensure_display
    if [ "${XDG_CURRENT_DESKTOP:-}" = "KDE" ] || [ "${KDE_FULL_SESSION:-}" = "true" ]; then
        echo "kde"
    elif command -v gsettings &>/dev/null && gsettings get org.gnome.desktop.session idle-delay &>/dev/null 2>&1; then
        echo "gnome"
    elif command -v xset &>/dev/null; then
        echo "xset"
    else
        echo "unknown"
    fi
}

# Get current idle delay
get_current_delay() {
    local system="$1"
    case "$system" in
        gnome)
            gsettings get org.gnome.desktop.session idle-delay 2>/dev/null | awk '{print $NF}' | grep -E '^[0-9]+$' || echo "1800"
            ;;
        xset)
            xset q 2>/dev/null | grep "timeout:" | awk '{print $2}' || echo "1800"
            ;;
        *)
            echo "1800"
            ;;
    esac
}

# Save current settings to ~/.lockscreen_settings for later restore
save_settings() {
    local system="$1"
    : > "$SETTINGS_FILE"
    case "$system" in
        gnome)
            echo "idle_delay=$(get_current_delay gnome)" >> "$SETTINGS_FILE"
            echo "lock_enabled=$(gsettings get org.gnome.desktop.screensaver lock-enabled 2>/dev/null | tr -d "'" || echo true)" >> "$SETTINGS_FILE"
            ;;
        kde)
            echo "xset_timeout=$(get_current_delay xset)" >> "$SETTINGS_FILE"
            local kautolock
            kautolock=$(kreadconfig5 --file kscreenlockerrc --group Daemon --key Autolock 2>/dev/null)
            [ -z "$kautolock" ] && kautolock="true"
            echo "kde_autolock=$kautolock" >> "$SETTINGS_FILE"
            ;;
        xset)
            echo "xset_timeout=$(get_current_delay xset)" >> "$SETTINGS_FILE"
            ;;
    esac
    log "Settings saved (system: $system)"
}

# Restore settings from ~/.lockscreen_settings
restore_settings() {
    local system="$1"
    [ -f "$SETTINGS_FILE" ] || return 0
    local idle_delay lock_enabled xset_timeout kde_autolock
    idle_delay=$(grep '^idle_delay=' "$SETTINGS_FILE" | cut -d= -f2)
    lock_enabled=$(grep '^lock_enabled=' "$SETTINGS_FILE" | cut -d= -f2)
    xset_timeout=$(grep '^xset_timeout=' "$SETTINGS_FILE" | cut -d= -f2)
    kde_autolock=$(grep '^kde_autolock=' "$SETTINGS_FILE" | cut -d= -f2)
    case "$system" in
        gnome)
            [ -n "$idle_delay" ] && gsettings set org.gnome.desktop.session idle-delay "$idle_delay"
            gsettings set org.gnome.desktop.screensaver lock-enabled "${lock_enabled:-true}"
            ;;
        kde)
            [ -n "$xset_timeout" ] && { xset s "$xset_timeout" "$xset_timeout"; xset +dpms; }
            [ -n "$kde_autolock" ] && kwriteconfig5 --file kscreenlockerrc --group Daemon --key Autolock "$kde_autolock" 2>/dev/null
            ;;
        xset)
            [ -n "$xset_timeout" ] && { xset s "$xset_timeout" "$xset_timeout"; xset +dpms; }
            ;;
    esac
    log "Settings restored (system: $system)"
}

# Fallback method (no systemd-inhibit): disable auto-lock via gsettings/xset
disable_lock() {
    local system="$1"
    ensure_display
    case "$system" in
        gnome)
            gsettings set org.gnome.desktop.session idle-delay 0
            gsettings set org.gnome.desktop.screensaver lock-enabled false
            gsettings set org.gnome.settings-daemon.plugins.power sleep-display-ac 0 2>/dev/null || true
            gsettings set org.gnome.settings-daemon.plugins.power sleep-display-battery 0 2>/dev/null || true
            ;;
        kde)
            xset s off
            xset -dpms
            xset s 0 0
            kwriteconfig5 --file kscreenlockerrc --group Daemon --key Autolock false 2>/dev/null
            ;;
        xset)
            xset s off
            xset -dpms
            xset s 0 0
            ;;
        unknown)
            xset s off 2>/dev/null || true
            xset -dpms 2>/dev/null || true
            ;;
    esac
    log "Fallback: auto-lock DISABLED (system: $system)"
}

# Start the idle inhibitor: blocks logind from treating the session
# as idle, so the 30-min auto-logout never triggers. No root needed.
start_inhibitor() {
    local seconds="$1"
    if ! command -v systemd-inhibit &>/dev/null; then
        echo "WARNING: systemd-inhibit not found — using fallback (gsettings/xset disable)."
        echo "  This will NOT protect a locked session on School21."
        return 1
    fi
    nohup systemd-inhibit --what=idle --mode=block --why="lockscreen timer" sleep "$seconds" >/dev/null 2>&1 &
    local pid=$!
    sleep 0.3
    if ! kill -0 "$pid" 2>/dev/null; then
        echo "WARNING: systemd-inhibit failed to register (process exited immediately)."
        echo "  Session will NOT be protected. Locking screen anyway."
        return 1
    fi
    echo "$pid" > "$INHIBITOR_FILE"
    log "Idle inhibitor started (PID: $(cat "$INHIBITOR_FILE"))"
    return 0
}

# Lock the screen immediately
lock_screen() {
    ensure_display
    local sid
    # Session column layout varies across systemd versions — try several layouts
    sid=$(loginctl list-sessions --no-legend 2>/dev/null | awk -v u="$USER" '$3==u && $6=="user" {print $1; exit}')
    [ -z "$sid" ] && sid=$(loginctl list-sessions --no-legend 2>/dev/null | awk -v u="$USER" '$3==u {print $1; exit}')
    [ -z "$sid" ] && sid=$(loginctl list-sessions --no-legend 2>/dev/null | awk -v u="$(id -u)" '$2==u {print $1; exit}')
    if [ -n "$sid" ] && loginctl lock-session "$sid" 2>/dev/null; then
        echo "Screen locked (loginctl, session: $sid)"
        return 0
    fi
    if command -v gdbus &>/dev/null && gdbus call --session --dest org.freedesktop.ScreenSaver --object-path /org/freedesktop/ScreenSaver --method org.freedesktop.ScreenSaver.Lock &>/dev/null; then
        echo "Screen locked (gdbus org.freedesktop.ScreenSaver)"
        return 0
    fi
    if command -v gdbus &>/dev/null && gdbus call --session --dest org.gnome.ScreenSaver --object-path /org/gnome/ScreenSaver --method org.gnome.ScreenSaver.Lock &>/dev/null; then
        echo "Screen locked (gdbus GNOME ScreenSaver)"
        return 0
    fi
    if command -v gnome-screensaver-command &>/dev/null && gnome-screensaver-command -l 2>/dev/null; then
        echo "Screen locked (gnome-screensaver-command)"
        return 0
    fi
    echo "WARNING: could not lock the screen — lock it manually (Super+L)."
    return 1
}

# Kill any existing timer + inhibitor from a previous run
kill_existing_timer() {
    local pid
    if [ -f "$TIMER_FILE" ]; then
        pid=$(cat "$TIMER_FILE" 2>/dev/null)
        [ -n "$pid" ] && kill "$pid" 2>/dev/null
        rm -f "$TIMER_FILE"
    fi
    if [ -f "$INHIBITOR_FILE" ]; then
        pid=$(cat "$INHIBITOR_FILE" 2>/dev/null)
        [ -n "$pid" ] && kill "$pid" 2>/dev/null
        rm -f "$INHIBITOR_FILE"
    fi
    rm -f "$RESTORE_SCRIPT"
    log "Old timer/inhibitor cleaned"
}

# Create the restore script that runs when the timer expires
create_restore_script() {
    local system="$1"
    local uid
    uid=$(id -u)

    cat > "$RESTORE_SCRIPT" << RESTORE_EOF
#!/bin/bash
export DISPLAY=":0"
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${uid}/bus"

if [ -f "${INHIBITOR_FILE}" ]; then
    IPID=\$(cat "${INHIBITOR_FILE}" 2>/dev/null)
    [ -n "\$IPID" ] && kill "\$IPID" 2>/dev/null
    rm -f "${INHIBITOR_FILE}"
fi

case "${system}" in
    gnome)
        IDLE=\$(grep '^idle_delay=' "${SETTINGS_FILE}" 2>/dev/null | cut -d= -f2)
        LOCK=\$(grep '^lock_enabled=' "${SETTINGS_FILE}" 2>/dev/null | cut -d= -f2)
        [ -n "\$IDLE" ] && gsettings set org.gnome.desktop.session idle-delay "\$IDLE"
        gsettings set org.gnome.desktop.screensaver lock-enabled "\${LOCK:-true}"
        ;;
    kde)
        XT=\$(grep '^xset_timeout=' "${SETTINGS_FILE}" 2>/dev/null | cut -d= -f2)
        KA=\$(grep '^kde_autolock=' "${SETTINGS_FILE}" 2>/dev/null | cut -d= -f2)
        [ -n "\$XT" ] && { xset s "\$XT" "\$XT"; xset +dpms; }
        [ -n "\$KA" ] && kwriteconfig5 --file kscreenlockerrc --group Daemon --key Autolock "\$KA"
        ;;
    xset)
        XT=\$(grep '^xset_timeout=' "${SETTINGS_FILE}" 2>/dev/null | cut -d= -f2)
        [ -n "\$XT" ] && { xset s "\$XT" "\$XT"; xset +dpms; }
        ;;
esac

echo "[\$(date '+%Y-%m-%d %H:%M:%S')] Timer expired. Session kept alive. Settings restored (system: ${system})" >> "${LOG_FILE}"
notify-send "lockscreen" "Timer done. Settings restored." 2>/dev/null || true
rm -f "${TIMER_FILE}" "${RESTORE_SCRIPT}"
RESTORE_EOF
    chmod +x "$RESTORE_SCRIPT"
}

# Show current status
show_status() {
    local system
    system=$(detect_lock_system)

    echo "=== lockscreen status ==="
    echo "Lock system: $system"

    if [ -f "$TIMER_FILE" ]; then
        local pid
        pid=$(cat "$TIMER_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            echo "Timer      : RUNNING (PID: $pid)"
        else
            echo "Timer      : STALE (process gone)"
            rm -f "$TIMER_FILE"
        fi
    else
        echo "Timer      : none"
    fi

    if [ -f "$INHIBITOR_FILE" ]; then
        local ipid
        ipid=$(cat "$INHIBITOR_FILE")
        if kill -0 "$ipid" 2>/dev/null; then
            echo "Inhibitor  : RUNNING (PID: $ipid) — session protected"
        else
            echo "Inhibitor  : STALE (process gone)"
            rm -f "$INHIBITOR_FILE"
        fi
    else
        echo "Inhibitor  : none — session NOT protected"
    fi

    echo ""
    echo "Current settings:"
    case "$system" in
        gnome)
            echo "  idle-delay   : $(gsettings get org.gnome.desktop.session idle-delay 2>/dev/null)"
            echo "  lock-enabled : $(gsettings get org.gnome.desktop.screensaver lock-enabled 2>/dev/null)"
            ;;
        kde)
            echo "  autolock     : $(kreadconfig5 --file kscreenlockerrc --group Daemon --key Autolock 2>/dev/null || echo 'default(true)')"
            xset q 2>/dev/null | grep -A3 "Screen Saver" || echo "  xset info unavailable"
            ;;
        xset)
            xset q 2>/dev/null | grep -A3 "Screen Saver" || echo "  xset info unavailable"
            ;;
    esac

    if [ -f "$LOG_FILE" ]; then
        echo ""
        echo "Last 5 log entries:"
        tail -5 "$LOG_FILE"
    fi
}

# Dry run: print the plan without any side effects
dry_run() {
    local seconds="$1"
    local system human
    system=$(detect_lock_system)
    human=$(human_time "$seconds")
    local restore_time
    restore_time=$(date -d "+${seconds} seconds" '+%H:%M' 2>/dev/null || echo "after $human")

    echo "=== lockscreen dry-run: $human ==="
    echo "Lock system : $system"
    echo "Plan:"
    echo "  1. Save current settings   ($SETTINGS_FILE)"
    echo "  2. Start idle inhibitor    (systemd-inhibit --what=idle --mode=block sleep $seconds)"
    echo "  3. Lock screen             (loginctl lock-session)"
    echo "  4. Start timer             (PID -> $TIMER_FILE)"
    echo "  5. After $human (~$restore_time): settings restored, session stays alive"
    echo "(dry-run: nothing was executed)"
}

# ─── MAIN ────────────────────────────────────────────────────────────────────

if [ $# -eq 0 ]; then
    echo "Usage:"
    echo "  lockscreen 6h          - lock screen now, keep session alive 6h"
    echo "  lockscreen 90m         - lock screen now, keep session alive 90 min"
    echo "  lockscreen off         - cancel timer, restore settings"
    echo "  lockscreen status      - show current status"
    echo "  lockscreen dry-run 6h  - show the plan without executing"
    exit 0
fi

ARG="$1"

case "$ARG" in
    off|OFF|restore|RESTORE)
        echo "Cancelling timer and restoring settings..."
        LOCK_SYSTEM=$(detect_lock_system)
        kill_existing_timer
        restore_settings "$LOCK_SYSTEM"
        echo "✓ Done. Timer cancelled, settings restored."
        notify-send "lockscreen" "Timer cancelled. Settings restored." 2>/dev/null || true
        ;;

    status|STATUS)
        show_status
        ;;

    dry-run|DRY-RUN|--dry-run)
        if [ -z "${2:-}" ]; then
            echo "Usage: lockscreen dry-run 6h"
            exit 1
        fi
        SECONDS_DURATION=$(parse_time "$2")
        if [[ "$SECONDS_DURATION" == ERROR* ]]; then
            echo "$SECONDS_DURATION"
            exit 1
        fi
        dry_run "$SECONDS_DURATION"
        ;;

    *)
        # Parse as time duration
        SECONDS_DURATION=$(parse_time "$ARG")
        if [[ "$SECONDS_DURATION" == ERROR* ]]; then
            echo "$SECONDS_DURATION"
            exit 1
        fi

        LOCK_SYSTEM=$(detect_lock_system)

        # Clean up any previous run
        kill_existing_timer

        # 1. Save current settings for restore
        save_settings "$LOCK_SYSTEM"

        # 2. Start idle inhibitor (blocks logind auto-logout)
        if start_inhibitor "$SECONDS_DURATION"; then
            METHOD="inhibitor"
        else
            METHOD="fallback"
            disable_lock "$LOCK_SYSTEM"
        fi

        # 3. Lock the screen now
        lock_screen

        # 4. Start background restore timer
        create_restore_script "$LOCK_SYSTEM"
        (
            sleep "$SECONDS_DURATION"
            bash "$RESTORE_SCRIPT"
        ) >/dev/null 2>&1 &
        TIMER_PID=$!
        echo "$TIMER_PID" > "$TIMER_FILE"
        disown "$TIMER_PID"

        # 5. Report
        HUMAN_TIME=$(human_time "$SECONDS_DURATION")
        RESTORE_TIME=$(date -d "+${SECONDS_DURATION} seconds" '+%H:%M' 2>/dev/null || echo "after $HUMAN_TIME")

        echo ""
        echo "✓ Locked. Session kept alive for $HUMAN_TIME"
        echo "  Restores at  : $RESTORE_TIME"
        echo "  Lock system  : $LOCK_SYSTEM"
        echo "  Method       : $METHOD"
        if [ "$METHOD" = "inhibitor" ]; then
            echo "  Inhibitor PID: $(cat "$INHIBITOR_FILE")"
        fi
        echo "  Timer PID    : $TIMER_PID"
        echo ""
        echo "  To cancel early: lockscreen off"

        notify-send "lockscreen" "Locked. Session kept alive for $HUMAN_TIME." 2>/dev/null || true
        log "Locked, session kept alive for ${SECONDS_DURATION}s (restores at $RESTORE_TIME), method: $METHOD, timer PID: $TIMER_PID"
        ;;
esac
